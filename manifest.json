{
  "manifest_version": 3,
  "name": "Video Downloader Pro",
  "version": "0.0.1",
  "description": "Phát hiện và tải MP4, WEBM, HLS với timeline cắt clip, hỗ trợ AES-128, fix 403 token.",
  "permissions": [
    "storage",
    "tabs",
    "downloads",
    "scripting",
    "webRequest",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content-scripts/page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content-scripts/media-scanner.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Video Downloader Pro - Mở Side Panel"
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "lib/*",
        "popup/*",
        "test/*",
        "utils/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}